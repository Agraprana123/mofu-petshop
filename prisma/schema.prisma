generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Enum ─────────────

enum Role {
  ADMIN
  CASHIER
  SALESMAN
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum MovementType {
  PURCHASE
  SALE
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT
}

// ───────────── Auth ─────────────

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(CASHIER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

// ───────────── Master data ─────────────

model Region {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  salesmen  Salesman[]
  customers Customer[]

  @@map("regions")
}

model Salesman {
  id       Int     @id @default(autoincrement())
  name     String
  phone    String?
  regionId Int?    @map("region_id")
  isActive Boolean @default(true) @map("is_active")
  region   Region? @relation(fields: [regionId], references: [id])
  sales    Sale[]

  @@map("salesmen")
}

model Customer {
  id       Int     @id @default(autoincrement())
  name     String
  phone    String?
  address  String?
  regionId Int?    @map("region_id")
  region   Region? @relation(fields: [regionId], references: [id])
  sales    Sale[]

  @@map("customers")
}

model Supplier {
  id        Int        @id @default(autoincrement())
  name      String
  phone     String?
  address   String?
  purchases Purchase[]

  @@map("suppliers")
}

model Category {
  id                  Int       @id @default(autoincrement())
  name                String    @unique
  // Margin default untuk semua produk di kategori ini (persen)
  defaultMarginPercent Decimal  @default(10) @map("default_margin_percent") @db.Decimal(5, 2)
  products            Product[]

  @@map("categories")
}

model Unit {
  id            Int            @id @default(autoincrement())
  code          String         @unique // PCS, SAK, GR, KG
  name          String
  products      Product[]
  productUnits  ProductUnit[]
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]

  @@map("units")
}

model Product {
  id            Int            @id @default(autoincrement())
  code          String         @unique
  name          String
  categoryId    Int            @map("category_id")
  baseUnitId    Int            @map("base_unit_id")
  // null = ikut default kategori
  marginPercent Decimal?       @map("margin_percent") @db.Decimal(5, 2)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")

  category      Category       @relation(fields: [categoryId], references: [id])
  baseUnit      Unit           @relation(fields: [baseUnitId], references: [id])
  units         ProductUnit[]
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
  batches       StockBatch[]
  movements     StockMovement[]

  @@map("products")
}

// Konversi satuan ke satuan dasar. Satuan dasar sendiri = 1.
// Contoh: SAK = 25 PCS
model ProductUnit {
  id               Int     @id @default(autoincrement())
  productId        Int     @map("product_id")
  unitId           Int     @map("unit_id")
  conversionToBase Decimal @map("conversion_to_base") @db.Decimal(18, 4)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit    Unit    @relation(fields: [unitId], references: [id])

  @@unique([productId, unitId])
  @@map("product_units")
}

// ───────────── Pembelian ─────────────

model Purchase {
  id          Int            @id @default(autoincrement())
  invoiceNo   String         @unique @map("invoice_no")
  supplierRef String?        @map("supplier_ref") // no. faktur dari supplier
  supplierId  Int            @map("supplier_id")
  date        DateTime
  total       Decimal        @default(0) @db.Decimal(18, 2)
  createdAt   DateTime       @default(now()) @map("created_at")

  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  items       PurchaseItem[]

  @@map("purchases")
}

model PurchaseItem {
  id          Int         @id @default(autoincrement())
  purchaseId  Int         @map("purchase_id")
  productId   Int         @map("product_id")
  unitId      Int         @map("unit_id")
  qty         Decimal     @db.Decimal(18, 3)
  unitCost    Decimal     @map("unit_cost") @db.Decimal(18, 2)
  qtyBase     Decimal     @map("qty_base") @db.Decimal(18, 3)
  costPerBase Decimal     @map("cost_per_base") @db.Decimal(18, 4)
  subtotal    Decimal     @db.Decimal(18, 2)

  purchase    Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])
  unit        Unit        @relation(fields: [unitId], references: [id])
  batch       StockBatch?

  @@map("purchase_items")
}

// ───────────── Stok (inti FIFO) ─────────────

model StockBatch {
  id             Int      @id @default(autoincrement())
  productId      Int      @map("product_id")
  purchaseItemId Int?     @unique @map("purchase_item_id")
  qtyIn          Decimal  @map("qty_in") @db.Decimal(18, 3)
  qtyRemaining   Decimal  @map("qty_remaining") @db.Decimal(18, 3)
  costPerBase    Decimal  @map("cost_per_base") @db.Decimal(18, 4)
  receivedAt     DateTime @default(now()) @map("received_at")

  product        Product         @relation(fields: [productId], references: [id])
  purchaseItem   PurchaseItem?   @relation(fields: [purchaseItemId], references: [id])
  allocations    SaleItemBatch[]
  movements      StockMovement[]

  @@index([productId, receivedAt])
  @@map("stock_batches")
}

model StockMovement {
  id        Int          @id @default(autoincrement())
  productId Int          @map("product_id")
  batchId   Int?         @map("batch_id")
  type      MovementType
  qtyBase   Decimal      @map("qty_base") @db.Decimal(18, 3) // + masuk, - keluar
  refType   String?      @map("ref_type")
  refId     Int?         @map("ref_id")
  createdAt DateTime     @default(now()) @map("created_at")

  product   Product      @relation(fields: [productId], references: [id])
  batch     StockBatch?  @relation(fields: [batchId], references: [id])

  @@index([productId, createdAt])
  @@map("stock_movements")
}

// ───────────── Penjualan ─────────────

model Sale {
  id            Int           @id @default(autoincrement())
  invoiceNo     String        @unique @map("invoice_no")
  customerId    Int?          @map("customer_id")
  salesmanId    Int?          @map("salesman_id")
  date          DateTime
  total         Decimal       @default(0) @db.Decimal(18, 2)
  paymentStatus PaymentStatus @default(PAID) @map("payment_status")
  createdAt     DateTime      @default(now()) @map("created_at")

  customer      Customer?     @relation(fields: [customerId], references: [id])
  salesman      Salesman?     @relation(fields: [salesmanId], references: [id])
  items         SaleItem[]

  @@map("sales")
}

model SaleItem {
  id        Int             @id @default(autoincrement())
  saleId    Int             @map("sale_id")
  productId Int             @map("product_id")
  unitId    Int             @map("unit_id")
  qty       Decimal         @db.Decimal(18, 3)
  qtyBase   Decimal         @map("qty_base") @db.Decimal(18, 3)
  subtotal  Decimal         @db.Decimal(18, 2)

  sale        Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id])
  unit        Unit            @relation(fields: [unitId], references: [id])
  allocations SaleItemBatch[]

  @@map("sale_items")
}

// Mencatat batch mana yang dipakai tiap penjualan.
// Harga dan modal di-snapshot di sini, jadi faktur lama tidak berubah.
model SaleItemBatch {
  id           Int        @id @default(autoincrement())
  saleItemId   Int        @map("sale_item_id")
  batchId      Int        @map("batch_id")
  qtyBase      Decimal    @map("qty_base") @db.Decimal(18, 3)
  costPerBase  Decimal    @map("cost_per_base") @db.Decimal(18, 4)
  pricePerBase Decimal    @map("price_per_base") @db.Decimal(18, 4)

  saleItem     SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  batch        StockBatch @relation(fields: [batchId], references: [id])

  @@map("sale_item_batches")
}

// ───────────── Penomoran faktur ─────────────

model Counter {
  key   String @id
  value Int    @default(0)

  @@map("counters")
}
